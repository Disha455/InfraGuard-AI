    "    f'evaluation/metrics/{EXP_NAME}.csv':          metrics_csv,\n",
    "    f'evaluation/metrics/{EXP_NAME}_summary.json': summary_json,\n",
    "}\n",
    "\n",
    "missing = [name for name, p in checks.items() if not Path(p).exists()]\n",
    "if missing:\n",
    "    raise FileNotFoundError(\n",
    "        f'FAIL: Cell 14 — missing evaluation outputs: {missing}\\n'\n",
    "        'Re-run Cell 13 and check the error output.')\n",
    "\n",
    "with summary_json.open() as f:\n",
